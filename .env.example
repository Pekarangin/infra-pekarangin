# ============================================================
# .env.example — Pekarang.in Infrastructure (Docker Compose)
# Salin file ini menjadi .env sebelum menjalankan docker compose
# ============================================================

# ---- PostgreSQL Database ----
POSTGRES_USER=pekarangin
POSTGRES_PASSWORD=pekarangin_secret
POSTGRES_DB=pekarangin_dev
DB_PORT=5432

# ---- Backend API (Express + Prisma) ----
BACKEND_PORT=3000
NODE_ENV=development
JWT_SECRET=dev_jwt_secret_ganti_ini_di_production_minimal_32_char
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=

# ---- AI Microservice (FastAPI + Gemini) ----
AI_PORT=8000
ENVIRONMENT=development
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Internal Docker network URL untuk komunikasi Backend -> AI Service
AI_SERVICE_URL=http://ai-service:8000
